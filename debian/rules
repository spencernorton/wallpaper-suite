#!/usr/bin/make -f
# Stamp source provenance; dh_installgsettings compiles the system schema.

%:
	dh $@

override_dh_auto_build:
	python3 build/stamp-build-info.py debian/generated/build-info.json

override_dh_auto_clean:
	rm -rf debian/generated

# D-Bus activates the static user service on demand. Package installation must
# neither enable it nor start it in an existing graphical session.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable
